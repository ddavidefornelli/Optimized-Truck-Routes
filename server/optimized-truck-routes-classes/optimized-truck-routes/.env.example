# Default mode is a small synthetic demo; it does not need external credentials.
ROAD_DATA_MODE=demo
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# For the Supabase database mode, set ROAD_DATA_MODE=supabase and add a server-side
# PostgreSQL connection string from Supabase. Never put this value in frontend code.
# Use SSL according to your Supabase connection details.
# SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres?sslmode=require
