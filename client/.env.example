# Development only: Vite forwards /api to the future FastAPI backend.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional production/cross-origin API origin. Empty = same origin.
# Public build-time settings; NEVER put secrets in VITE_* variables.
VITE_API_BASE_URL=
VITE_ROUTES_ENDPOINT=/api/v1/routes

# Optional MapLibre style URL override. Empty = CARTO Positron (street basemap).
# Default requests style, tiles, sprites and fonts from CARTO's public CDN.
# Check provider terms for production use; keep required attribution visible.
VITE_MAP_STYLE_URL=

# Public browser key for address autocomplete (Finland pilot). Empty disables search.
# Set in ignored .env.local; restrict allowed origins in the Geoapify dashboard.
VITE_GEOAPIFY_API_KEY=
